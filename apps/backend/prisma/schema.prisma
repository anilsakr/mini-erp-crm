// Prisma schema for the Mini ERP + CRM Operations Portal.
//
// ID strategy: every table uses a UUID primary key (String @default(uuid())).
// Rationale (see docs/architecture.md): UUIDs are safe to expose in URLs
// (no enumeration of customers/products/challans by guessing sequential ids),
// and they can be generated by the application/Prisma without a DB round trip.
// Tradeoff: slightly larger index size than a serial integer — acceptable at
// this scale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customersCreated     Customer[]         @relation("CustomerCreatedBy")
  followUpsCreated     CustomerFollowUp[] @relation("FollowUpCreatedBy")
  stockMovementsCreated StockMovement[]   @relation("StockMovementCreatedBy")
  challansCreated      Challan[]          @relation("ChallanCreatedBy")

  @@map("users")
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  mobile       String
  email        String?
  businessName String         @map("business_name")
  gstNumber    String?        @map("gst_number")
  customerType CustomerType   @map("customer_type")
  address      String
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?      @map("follow_up_date")
  notes        String?
  createdById  String         @map("created_by")
  createdBy    User           @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  followUps CustomerFollowUp[]
  challans  Challan[]

  @@index([name])
  @@index([mobile])
  @@index([email])
  @@index([status])
  @@map("customers")
}

// Append-only history: a follow-up is never edited or deleted, only added.
// This is what lets the UI show a full follow-up timeline per customer
// instead of a single overwritten "notes" field.
model CustomerFollowUp {
  id           String    @id @default(uuid())
  customerId   String    @map("customer_id")
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note         String
  followUpDate DateTime? @map("follow_up_date")
  createdById  String    @map("created_by")
  createdBy    User      @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_follow_ups")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  products Product[]

  @@map("categories")
}

model Warehouse {
  id       String @id @default(uuid())
  name     String
  location String

  products Product[]

  @@map("warehouses")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  currentStock  Int      @default(0) @map("current_stock")
  minStockAlert Int      @default(0) @map("min_stock_alert")
  warehouseId   String   @map("warehouse_id")
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([sku])
  @@index([name])
  @@index([currentStock])
  @@map("products")
}

// Append-only audit log. current_stock on Product must only ever change in
// the same DB transaction that inserts a row here — see challan.service.ts
// and stock.service.ts. This is what "stock changes must be auditable" means
// in practice: you can always reconstruct how current_stock was reached.
model StockMovement {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  product       Product      @relation(fields: [productId], references: [id])
  quantityChanged Int        @map("quantity_changed")
  movementType  MovementType @map("movement_type")
  reason        String
  createdById   String       @map("created_by")
  createdBy     User         @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Challan {
  id             String        @id @default(uuid())
  challanNumber  String        @unique @map("challan_number")
  customerId     String        @map("customer_id")
  customer       Customer      @relation(fields: [customerId], references: [id])
  status         ChallanStatus @default(DRAFT)
  totalQuantity  Int           @default(0) @map("total_quantity")
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  createdById    String        @map("created_by")
  createdBy      User          @relation("ChallanCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  items ChallanItem[]

  @@index([challanNumber])
  @@index([status])
  @@index([customerId])
  @@map("challans")
}

// Product snapshot fields (productNameSnapshot / skuSnapshot / unitPriceSnapshot)
// are intentionally denormalized copies taken at challan-creation time.
// Why: if a product's name or price is edited later, historical challans
// must still show what was actually sold and at what price — they must not
// silently change. productId is kept only for traceability/reporting back
// to the current product record, never for rendering the challan itself.
model ChallanItem {
  id                    String  @id @default(uuid())
  challanId             String  @map("challan_id")
  challan               Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId             String  @map("product_id")
  product               Product @relation(fields: [productId], references: [id])
  productNameSnapshot   String  @map("product_name_snapshot")
  skuSnapshot           String  @map("sku_snapshot")
  unitPriceSnapshot     Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity              Int
  lineTotal             Decimal @map("line_total") @db.Decimal(14, 2)

  @@index([challanId])
  @@index([productId])
  @@map("challan_items")
}
